# Copy this file to .env.test.local, use a dedicated disposable database whose name contains
# "test", then opt in explicitly with:
# php bin/run_checks.php --profile=db --env-file=.env.test.local --fail-on-skip
#
# Values are literal. Do not add shell quotes, variable references, exports, or production secrets.
XIUNO_DB_HOST=127.0.0.1
XIUNO_DB_PORT=3306
XIUNO_DB_NAME=xiuno_next_test
XIUNO_DB_USER=xiuno_test
XIUNO_DB_PASSWORD=change_this_test_password
XIUNO_SQL_MODE=STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
XIUNO_EXPECT_MYSQL_MAJOR=8
XIUNO_ALLOW_DESTRUCTIVE_SMOKE=0
