{
    "name": "xiuno/xiuno-next",
    "description": "The Next Generation of Xiuno BBS - Lightweight, Fast, and Modern.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Xiuno Contributors",
            "homepage": "https://github.com/shikelea/Xiuno-Next"
        }
    ],
    "require": {
        "php": ">=8.0.2",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-zip": "*",
        "phpmailer/phpmailer": "^6.9",
        "symfony/console": "^6.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Xiuno\\": "src/"
        }
    },
    "scripts": {
        "fix": "php-cs-fixer fix",
        "check": "php-cs-fixer fix --dry-run --diff",
        "test": "php bin/run_checks.php --profile=deterministic",
        "test:browser": "php bin/run_checks.php --profile=browser",
        "test:db": "php bin/run_checks.php --profile=db --fail-on-skip",
        "test:docker": "php bin/run_checks.php --profile=docker",
        "test:full": "php bin/run_checks.php --profile=full --fail-on-skip",
        "docs:hooks": "php bin/generate_hook_docs.php",
        "check:version": "php bin/check_version.php"
    },
    "config": {
        "platform": {
            "php": "8.0.2"
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    }
}
