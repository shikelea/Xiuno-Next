#!/usr/bin/env php
<?php

$root = realpath(__DIR__ . '/..');
if ($root === false) {
    fwrite(STDERR, "Unable to locate project root.\n");
    exit(1);
}

defined('DEBUG') || define('DEBUG', 0);
defined('APP_PATH') || define('APP_PATH', $root . DIRECTORY_SEPARATOR);
defined('XIUNOPHP_PATH') || define('XIUNOPHP_PATH', APP_PATH . 'xiunophp' . DIRECTORY_SEPARATOR);

if (file_exists(APP_PATH . 'vendor/autoload.php')) {
    require APP_PATH . 'vendor/autoload.php';
} else {
    fwrite(STDERR, "Please run \"composer install\" before using Xiuno CLI.\n");
    exit(1);
}

use Symfony\Component\Console\Application;
use Xiuno\Console\Command\MakePluginCommand;
use Xiuno\Console\Command\MigrateCommand;
use Xiuno\Console\Command\UpgradeCommand;

const XIUNO_CLI_VERSION = '4.5.7';

$application = new Application('Xiuno CLI', XIUNO_CLI_VERSION);

$application->add(new MakePluginCommand());
$application->add(new MigrateCommand());
$application->add(new UpgradeCommand());

$application->run();
